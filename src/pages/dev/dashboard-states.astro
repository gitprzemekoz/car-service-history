---
import Layout from "@/layouts/Layout.astro";
import ClientDashboardView from "@/components/ClientDashboardView.astro";
import type { ServiceEntry } from "@/lib/types";

// Dev-only kitchen sink: every client dashboard state from inline fixtures, for screenshot gating.
// The rule crashes on a top-level frontmatter `return` ("Expected node to have a parent"), so it is off here.
/* eslint @typescript-eslint/no-misused-promises: "off" */
if (!import.meta.env.DEV) {
  return new Response(null, { status: 404 });
}

const email = "client@example.com";
const vehicle = { make: "Toyota", model: "Corolla", registration_number: "KR 12345" };

const base = { vehicle_id: "v-1", mechanic_id: "m-1" };

const entries: ServiceEntry[] = [
  {
    ...base,
    id: "e-1",
    service_type: "Oil change",
    service_date: "2026-09-23",
    mileage: 85000,
    cost: 150,
    notes: "Replaced oil filter.\nTop up coolant at next visit.",
    next_due_mileage: 95000,
    next_due_date: "2027-09-23",
    created_at: "2026-09-23T10:00:00Z",
  },
  {
    ...base,
    id: "e-2",
    service_type: "Tyre rotation",
    service_date: "2026-03-14",
    mileage: 8500,
    cost: null,
    notes: null,
    next_due_mileage: null,
    next_due_date: null,
    created_at: "2026-03-14T09:00:00Z",
  },
  {
    ...base,
    id: "e-3",
    service_type: "Brake inspection",
    service_date: "2026-09-23",
    mileage: 85000,
    cost: 80.5,
    notes: null,
    next_due_mileage: 100000,
    next_due_date: null,
    created_at: "2026-09-23T08:00:00Z",
  },
];

const states = [
  {
    label: "(a) Vehicle with 3 entries (same-day tie-break: Oil change above Brake inspection)",
    props: { vehicle, entries },
  },
  { label: "(b) Vehicle with 0 entries", props: { vehicle, entries: [] } },
  { label: "(c) Load error", props: { vehicle: null, entries: [], loadError: true } },
  { label: "(d) No vehicle", props: { vehicle: null, entries: [] } },
  { label: "(e) Focus: sign-out button focused", props: { vehicle, entries, autofocusSignOut: true } },
];
---

<Layout title="Dashboard states (dev)">
  <main class="bg-background">
    {states.map((state) => (
      <section class="state-frame border-b-4 border-dashed border-border">
        <p class="bg-muted px-4 py-1 font-mono text-xs text-muted-foreground">{state.label}</p>
        <ClientDashboardView email={email} loadError={false} {...state.props} />
      </section>
    ))}
  </main>
</Layout>

<style is:global>
  /* Each state is stacked; the view's full-viewport min height would make every frame one screen tall. */
  .state-frame .min-h-screen {
    min-height: 0;
  }
  /* The dev toolbar is not part of the view and would land in every screenshot. */
  astro-dev-toolbar {
    display: none !important;
  }
</style>
