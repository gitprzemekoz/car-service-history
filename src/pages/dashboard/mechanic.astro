---
import Layout from "@/layouts/Layout.astro";
import AddClientForm from "@/components/mechanic/AddClientForm";
import { createClient } from "@/lib/supabase";
import type { Client, Vehicle } from "@/lib/types";

type VehicleSummary = Pick<Vehicle, "make" | "model" | "registration_number">;

// Without a unique *constraint* PostgREST may embed the one-per-client vehicle as an array.
type ClientRow = Pick<Client, "id" | "name" | "email" | "user_id"> & {
  vehicles: VehicleSummary[] | VehicleSummary | null;
};

const { user } = Astro.locals;
const error = Astro.url.searchParams.get("error");

const supabase = createClient(Astro.request.headers, Astro.cookies);

// RLS scopes this to the signed-in mechanic's clients.
const { data } = supabase
  ? await supabase
      .from("clients")
      .select("id, name, email, user_id, vehicles(make, model, registration_number)")
      .order("name")
  : { data: null };

const clients = ((data ?? []) as ClientRow[]).map((row) => ({
  ...row,
  vehicle: Array.isArray(row.vehicles) ? (row.vehicles[0] ?? null) : row.vehicles,
}));
---

<Layout title="Mechanic Dashboard">
  <div class="bg-cosmic min-h-screen p-4">
    <div class="mx-auto max-w-3xl space-y-6 py-8 text-white">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <div>
          <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
            Mechanic Dashboard
          </h1>
          <p class="mt-1 text-sm text-blue-100/80">
            Signed in as <span class="font-semibold text-white">{user?.email}</span>
          </p>
        </div>
        <form method="POST" action="/api/auth/signout">
          <button
            type="submit"
            class="rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm transition-colors hover:bg-white/20"
          >
            Sign out
          </button>
        </form>
      </div>

      <section class="rounded-2xl border border-white/10 bg-white/10 p-6 backdrop-blur-xl">
        <h2 class="mb-4 text-xl font-semibold">Clients</h2>
        {clients.length === 0 ? (
          <p class="text-sm text-blue-100/60">No clients yet. Add your first client below.</p>
        ) : (
          <ul class="space-y-3">
            {clients.map((client) => (
              <li>
                <a
                  href={`/dashboard/mechanic/clients/${client.id}`}
                  class="block rounded-lg border border-white/10 bg-white/5 p-4 transition-colors hover:bg-white/10"
                >
                  <div class="flex flex-wrap items-baseline justify-between gap-2">
                    <span class="font-semibold text-white">{client.name}</span>
                    <span class="text-sm text-blue-100/60">{client.email}</span>
                  </div>
                  {client.vehicle && (
                    <p class="mt-1 text-sm text-blue-100/80">
                      {client.vehicle.make} {client.vehicle.model} · {client.vehicle.registration_number}
                    </p>
                  )}
                  <p class="mt-1 text-xs">
                    {client.user_id ? (
                      <span class="text-green-300">Linked</span>
                    ) : (
                      <span class="text-amber-300">
                        Waiting for signup — ask the client to sign up with {client.email}
                      </span>
                    )}
                  </p>
                </a>
              </li>
            ))}
          </ul>
        )}
      </section>

      <section class="rounded-2xl border border-white/10 bg-white/10 p-6 backdrop-blur-xl">
        <h2 class="mb-4 text-xl font-semibold">Add client</h2>
        <AddClientForm serverError={error} client:load />
      </section>
    </div>
  </div>
</Layout>
