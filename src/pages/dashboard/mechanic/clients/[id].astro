---
import Layout from "@/layouts/Layout.astro";
import ServiceEntryForm from "@/components/mechanic/ServiceEntryForm";
import ServiceHistory from "@/components/ServiceHistory.astro";
import { createClient } from "@/lib/supabase";
import type { Client, ServiceEntry, Vehicle } from "@/lib/types";
import { toLocalIsoDate } from "@/lib/validation";

type VehicleWithEntries = Pick<Vehicle, "id" | "make" | "model" | "registration_number"> & {
  service_entries: ServiceEntry[] | null;
};

// Without a unique *constraint* PostgREST may embed the one-per-client vehicle as an array.
type ClientRow = Pick<Client, "id" | "name" | "email" | "user_id"> & {
  vehicles: VehicleWithEntries[] | VehicleWithEntries | null;
};

const id = Astro.params.id ?? "";
const error = Astro.url.searchParams.get("error");

const supabase = createClient(Astro.request.headers, Astro.cookies);

// RLS-scoped: another mechanic's client (or a malformed id) yields no row.
const { data } = supabase
  ? await supabase
      .from("clients")
      .select("id, name, email, user_id, vehicles(id, make, model, registration_number, service_entries(*))")
      .eq("id", id)
      .maybeSingle()
  : { data: null };

// Set the status instead of returning a Response: a top-level `return` in frontmatter
// crashes typescript-eslint's no-misused-promises rule on .astro files.
if (!data) {
  Astro.response.status = 404;
}

const client = data as ClientRow | null;
const vehicle = Array.isArray(client?.vehicles) ? (client.vehicles[0] ?? null) : (client?.vehicles ?? null);
const entries = vehicle?.service_entries ?? [];
const editHref = (entry: ServiceEntry) =>
  `/dashboard/mechanic/clients/${encodeURIComponent(id)}/entries/${encodeURIComponent(entry.id)}/edit`;
---

{!client && (
  <Layout title="Client not found">
    <div class="bg-background flex min-h-screen items-center justify-center p-4">
      <div class="rounded-2xl border border-border bg-card p-8 text-center text-card-foreground shadow-sm">
        <h1 class="mb-4 text-2xl font-bold">Client not found</h1>
        <a href="/dashboard/mechanic" class="text-sm text-primary underline-offset-4 hover:underline">
          &larr; Back to clients
        </a>
      </div>
    </div>
  </Layout>
)}
{client && (
  <Layout title={`${client.name} — Mechanic Dashboard`}>
    <div class="bg-background min-h-screen p-4">
      <div class="mx-auto max-w-3xl space-y-6 py-8 text-foreground">
        <a href="/dashboard/mechanic" class="text-sm text-primary underline-offset-4 hover:underline">
          &larr; Back to clients
        </a>

        <section class="rounded-2xl border border-border bg-card p-6 text-card-foreground shadow-sm">
          <h1 class="text-3xl font-bold text-foreground">{client.name}</h1>
          <p class="mt-1 text-sm text-foreground">{client.email}</p>
          <p class="mt-1 text-xs">
            {client.user_id ? (
              <span class="text-green-700">Linked</span>
            ) : (
              <span class="text-amber-700">Waiting for signup — ask the client to sign up with {client.email}</span>
            )}
          </p>
          {vehicle ? (
            <p class="mt-4 text-foreground">
              <span class="font-semibold text-foreground">
                {vehicle.make} {vehicle.model}
              </span>{" "}
              · {vehicle.registration_number}
            </p>
          ) : (
            <p class="mt-4 text-sm text-muted-foreground">No vehicle yet.</p>
          )}
        </section>

        <section class="rounded-2xl border border-border bg-card p-6 text-card-foreground shadow-sm">
          <h2 class="mb-4 text-xl font-semibold">Service history</h2>
          <ServiceHistory entries={entries} editHref={editHref} />
        </section>

        {vehicle && (
          <section class="rounded-2xl border border-border bg-card p-6 text-card-foreground shadow-sm">
            <h2 class="mb-4 text-xl font-semibold">Add service entry</h2>
            <ServiceEntryForm
              action={`/api/clients/${encodeURIComponent(client.id)}/entries`}
              initialValues={{
                serviceType: "",
                serviceDate: toLocalIsoDate(new Date()),
                mileage: "",
                cost: "",
                notes: "",
                nextDueMileage: "",
                nextDueDate: "",
              }}
              submitLabel="Add service entry"
              pendingText="Adding entry..."
              serverError={error}
              client:load
            />
          </section>
        )}
      </div>
    </div>
  </Layout>
)}
