---
import Layout from "@/layouts/Layout.astro";
import ClientDashboardView from "@/components/ClientDashboardView.astro";
import { createClient } from "@/lib/supabase";
import type { Client, ServiceEntry, ShareLink, Vehicle } from "@/lib/types";

type VehicleWithEntries = Pick<Vehicle, "id" | "make" | "model" | "registration_number"> & {
  service_entries: ServiceEntry[] | null;
};

// Without a unique *constraint* PostgREST may embed the one-per-client vehicle as an array.
type ClientRow = Pick<Client, "id"> & {
  vehicles: VehicleWithEntries[] | VehicleWithEntries | null;
};

const { user } = Astro.locals;

const supabase = createClient(Astro.request.headers, Astro.cookies);

// RLS-scoped (clients_select_own): only the signed-in client's own linked row is visible.
const { data, error } =
  supabase && user
    ? await supabase
        .from("clients")
        .select("id, vehicles(id, make, model, registration_number, service_entries(*))")
        .eq("user_id", user.id)
        .maybeSingle()
    : { data: null, error: null };

const loadError = Boolean(error);
const client = data as ClientRow | null;
const vehicle = Array.isArray(client?.vehicles) ? (client.vehicles[0] ?? null) : (client?.vehicles ?? null);
const entries = vehicle?.service_entries ?? [];

// RLS-scoped (share_links_select_client): at most one row per vehicle. Expiry is decided by the card.
const { data: shareLinkRow } =
  supabase && vehicle
    ? await supabase.from("share_links").select("token, expires_at").eq("vehicle_id", vehicle.id).maybeSingle()
    : { data: null };
const shareLink: Pick<ShareLink, "token" | "expires_at"> | null = shareLinkRow;
const shareError = Astro.url.searchParams.get("error") ?? undefined;
---

<Layout title="Dashboard">
  <ClientDashboardView
    email={user?.email}
    vehicle={vehicle}
    entries={entries}
    loadError={loadError}
    shareLink={shareLink}
    origin={Astro.url.origin}
    shareError={shareError}
  />
</Layout>
