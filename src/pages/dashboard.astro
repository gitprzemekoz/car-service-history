---
import Layout from "@/layouts/Layout.astro";
import ServiceHistory from "@/components/ServiceHistory.astro";
import { createClient } from "@/lib/supabase";
import type { Client, ServiceEntry, Vehicle } from "@/lib/types";

type VehicleWithEntries = Pick<Vehicle, "id" | "make" | "model" | "registration_number"> & {
  service_entries: ServiceEntry[] | null;
};

// Without a unique *constraint* PostgREST may embed the one-per-client vehicle as an array.
type ClientRow = Pick<Client, "id"> & {
  vehicles: VehicleWithEntries[] | VehicleWithEntries | null;
};

const { user } = Astro.locals;

const supabase = createClient(Astro.request.headers, Astro.cookies);

// RLS-scoped (clients_select_own): only the signed-in client's own linked row is visible.
const { data } =
  supabase && user
    ? await supabase
        .from("clients")
        .select("id, vehicles(id, make, model, registration_number, service_entries(*))")
        .eq("user_id", user.id)
        .maybeSingle()
    : { data: null };

const client = data as ClientRow | null;
const vehicle = Array.isArray(client?.vehicles) ? (client.vehicles[0] ?? null) : (client?.vehicles ?? null);
const entries = vehicle?.service_entries ?? [];
---

<Layout title="Dashboard">
  <div class="bg-cosmic min-h-screen p-4">
    <div class="mx-auto max-w-3xl space-y-6 py-8 text-white">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <div>
          <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
            My vehicle
          </h1>
          <p class="mt-1 text-sm text-blue-100/80">
            Signed in as <span class="font-semibold text-white">{user?.email}</span>
          </p>
        </div>
        <form method="POST" action="/api/auth/signout">
          <button
            type="submit"
            class="rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm transition-colors hover:bg-white/20"
          >
            Sign out
          </button>
        </form>
      </div>

      {vehicle ? (
        <>
          <section class="rounded-2xl border border-white/10 bg-white/10 p-6 backdrop-blur-xl">
            <h2 class="mb-2 text-xl font-semibold">
              {vehicle.make} {vehicle.model}
            </h2>
            <p class="text-blue-100/90">{vehicle.registration_number}</p>
          </section>

          <section class="rounded-2xl border border-white/10 bg-white/10 p-6 backdrop-blur-xl">
            <h2 class="mb-4 text-xl font-semibold">Service history</h2>
            <ServiceHistory entries={entries} />
          </section>
        </>
      ) : (
        <section class="rounded-2xl border border-white/10 bg-white/10 p-6 backdrop-blur-xl">
          <p class="text-sm text-blue-100/60">No vehicle yet.</p>
        </section>
      )}
    </div>
  </div>
</Layout>
