---
import { formatCost, formatMileage, formatServiceDate, sortNewestFirst } from "@/lib/service-history";
import type { ServiceEntry } from "@/lib/types";

interface Props {
  entries: ServiceEntry[];
  // Set only by the mechanic page; the client view renders no edit links.
  editHref?: (entry: ServiceEntry) => string;
}

const { entries, editHref } = Astro.props;

const sorted = sortNewestFirst(entries);
---

{sorted.length === 0 ? (
  <p class="text-sm text-muted-foreground">No service entries yet — entries appear here after each service visit.</p>
) : (
  <ul class="space-y-3">
    {sorted.map((entry) => (
      <li class="rounded-lg border border-border bg-muted/50 p-4">
        <div class="flex flex-wrap items-baseline justify-between gap-2">
          <span class="font-semibold text-foreground">{entry.service_type}</span>
          <span class="flex items-baseline gap-3">
            <span class="text-sm text-muted-foreground">{formatServiceDate(entry.service_date)}</span>
            {editHref && (
              <a href={editHref(entry)} class="text-sm text-primary underline-offset-4 hover:underline">
                Edit
              </a>
            )}
          </span>
        </div>
        <dl class="mt-2 grid grid-cols-2 gap-x-4 gap-y-1 text-sm">
          <dt class="text-muted-foreground">Mileage</dt>
          <dd class="text-foreground">{formatMileage(entry.mileage)}</dd>
          <dt class="text-muted-foreground">Cost</dt>
          <dd class="text-foreground">{formatCost(entry.cost)}</dd>
          <dt class="text-muted-foreground">Next due mileage</dt>
          <dd class="text-foreground">
            {entry.next_due_mileage === null ? "—" : formatMileage(entry.next_due_mileage)}
          </dd>
          <dt class="text-muted-foreground">Next due date</dt>
          <dd class="text-foreground">{entry.next_due_date === null ? "—" : formatServiceDate(entry.next_due_date)}</dd>
        </dl>
        {entry.notes && <p class="mt-2 text-sm whitespace-pre-line text-foreground">{entry.notes}</p>}
      </li>
    ))}
  </ul>
)}
