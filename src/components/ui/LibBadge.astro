---
interface Props {
  label: string;
  version?: string;
}

const { label, version } = Astro.props;
---

<span class="inline-flex items-center gap-2 rounded-lg bg-secondary px-3 py-1.5 font-mono text-secondary-foreground shadow-sm">
  {label}
  {version && <span class="rounded-full bg-primary/10 px-2 py-0.5 text-xs text-primary">{version}</span>}
</span>
